# Conexão Neon Serverless Postgres (Pooler e Direct)
DATABASE_URL="postgresql://neondb_owner:SENHA@ep-plain-waterfall-b6p9dwf0-pooler.c-2.sa-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:SENHA@ep-plain-waterfall-b6p9dwf0.c-2.sa-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
NEON_BRANCH=production

# Chave da API Resend (para envio de e-mails via backend/serverless)
RESEND_API_KEY=re_sua_chave_resend_aqui

# Gmail SMTP (envio direto autenticado via SMTP)
GMAIL_USER=seu-email@gmail.com
GMAIL_APP_PASSWORD=sua_senha_de_app_16_digitos
