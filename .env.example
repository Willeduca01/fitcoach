# ==========================================
# FitCoach Pro — Variáveis de Ambiente Supabase
# ==========================================
# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA envie o arquivo .env para o GitHub!

# URL do projeto Supabase
VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co

# Chave Anônima Pública (Anon Key) - Segura para o Frontend com RLS ativo
VITE_SUPABASE_ANON_KEY=sua_chave_anonima_aqui

# Chave de Serviço (Service Role Key) - APENAS para scripts administrativos backend
# NUNCA exponha esta chave no código do cliente!
# SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_aqui

# Chave da API Resend (para envio de e-mails via backend/serverless)
RESEND_API_KEY=re_sua_chave_resend_aqui

# Gmail SMTP (alternativa para envio direto de e-mails)
GMAIL_USER=seu-email@gmail.com
GMAIL_APP_PASSWORD=sua_senha_de_app_16_digitos
